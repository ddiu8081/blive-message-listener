{
  "name": "blive-message-listener",
  "version": "0.5.5",
  "description": "Bilibili-live danmu listener with type",
  "keywords": [
    "bilibili",
    "bilibili-live",
    "danmaku",
    "danmu"
  ],
  "homepage": "https://github.com/ddiu8081/blive-message-listener#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddiu8081/blive-message-listener.git"
  },
  "license": "MIT",
  "author": "ddiu8081 <ddiu8081@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "ultracite check",
    "ci": "bun run check && bun run typecheck && bun test && bun run build && bun run examples:build",
    "dev": "tsdown --watch",
    "example:browser": "bun run build && bun run --cwd examples/browser dev",
    "example:node": "bun run build && bun run --cwd examples/node dev",
    "examples:build": "bun --filter './examples/*' build",
    "fix": "ultracite fix",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "protobufjs": "^8.0.0",
    "tiny-bilibili-ws": "^1.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/bun": "1.4.0",
    "changelogithub": "15.0.4",
    "publint": "0.3.24",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "ultracite": "7.10.6"
  },
  "packageManager": "bun@1.3.6",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20.0.0"
  }
}
